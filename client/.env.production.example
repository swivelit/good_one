REACT_APP_BACKEND_URL=https://good-one-api.onrender.com
REACT_APP_API_URL=https://good-one-api.onrender.com/api
# Public HTTPS website origin used in shared product/vendor links and Android App Links.
REACT_APP_PUBLIC_WEB_URL=https://good-one-jlcu.onrender.com
REACT_APP_SUPPORT_EMAIL=goodone@swivelit.in
# Local GoodOne floating video promo. Keep disabled in production unless
# explicitly testing it, and never show it over AdMob surfaces.
REACT_APP_ENABLE_LOCAL_FLOATING_VIDEO_AD=false
# Use false only for approved production release builds.
REACT_APP_USE_ADMOB_TEST_ADS=false
# Optional production AdMob unit IDs. Leave unset for local test builds.
# Bottom overlay banner uses the production BANNER unit when test ads are off:
REACT_APP_ADMOB_ANDROID_BANNER_ID=ca-app-pub-9859771616835832/2509706314
# REACT_APP_ADMOB_ANDROID_APP_OPEN_ID=
REACT_APP_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-9859771616835832/7980278971
# REACT_APP_ADMOB_ANDROID_REWARDED_ID=
# In-feed (inline) ads require a NATIVE ad unit (not a banner unit) + the custom
# native Capacitor plugin. Leave unset to use Google's native test unit in dev.
REACT_APP_ADMOB_ANDROID_NATIVE_ID=ca-app-pub-9859771616835832/9924103380
# ca-app-pub-9859771616835832/9528517561 is a banner unit and must not be used
# as the Native Advanced in-feed ad.
# REACT_APP_ADMOB_IOS_BANNER_ID=
# REACT_APP_ADMOB_IOS_APP_OPEN_ID=
# REACT_APP_ADMOB_IOS_INTERSTITIAL_ID=
# REACT_APP_ADMOB_IOS_REWARDED_ID=
# REACT_APP_ADMOB_IOS_NATIVE_ID=

PORT=5000
NODE_ENV=development
JWT_SECRET=change_me
JWT_EXPIRE=7d
DATABASE_URL=postgresql://user:password@host:5432/goodone
EMAIL_USER=goodone@swivelit.in
EMAIL_PASS=your_email_app_password_or_smtp_password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM="GoodOne <goodone@swivelit.in>"
# Testing only. Never enable these in production.
ENABLE_TEST_OTP=false
OTP_BYPASS_CODE=
CLIENT_URLS=http://localhost:3000,http://localhost:3001,https://good-one-jlcu.onrender.com,capacitor://localhost,ionic://localhost,http://localhost,https://localhost
UPLOAD_DIR=
# Required for real FCM push delivery. Do not commit service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON for local/server environments.
GOOGLE_APPLICATION_CREDENTIALS=
BLOCKED_TERMS=spam,scam,fake
MIN_SUPPORTED_ANDROID_VERSION_CODE=3
LATEST_ANDROID_VERSION_CODE=4
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.goodone.marketplace
# Single admin login (no DB user). Override the real password via env vars in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GoodOne@Admin2026
